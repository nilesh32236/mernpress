generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  administrator
  editor
  author
  contributor
  subscriber
}

enum UserStatus {
  active
  disabled
}

model User {
  id                   String     @id @default(uuid(7)) @db.Uuid
  username             String     @unique @db.VarChar(32)
  /// Optional contact email (WordPress-style Name/Email columns).
  email                String?    @unique @db.VarChar(254)
  /// Optional display name shown in the admin.
  displayName          String?    @map("display_name") @db.VarChar(100)
  /// WordPress "First Name".
  firstName            String?    @map("first_name") @db.VarChar(100)
  /// WordPress "Last Name".
  lastName             String?    @map("last_name") @db.VarChar(100)
  /// WordPress "Nickname".
  nickname             String?    @db.VarChar(100)
  /// Optional biographical info (WordPress "About Yourself").
  bio                  String?    @db.Text
  /// Optional website URL.
  website              String?    @db.VarChar(2048)
  /// WordPress "Syntax Highlighting": highlight code in the editor.
  syntaxHighlighting   Boolean    @default(true) @map("syntax_highlighting")
  /// WordPress profile language (per user). Only en_US ships in this build.
  locale               String     @default("en_US") @db.VarChar(20)
  /// WordPress administration colour scheme (modern, fresh, light, blue, …).
  adminColor           String     @default("fresh") @map("admin_color") @db.VarChar(20)
  /// Per-user Screen Options: columns, per-page counts, view modes and editor panels.
  screenOptions        Json       @default("{}") @map("screen_options")
  /// AES-256-GCM sealed TOTP secret; null when 2FA is not configured.
  twoFactorSecret      String?    @map("two_factor_secret") @db.Text
  twoFactorEnabled     Boolean    @default(false) @map("two_factor_enabled")
  twoFactorConfirmedAt DateTime?  @map("two_factor_confirmed_at") @db.Timestamptz(6)
  /// Highest accepted TOTP counter, so a code cannot be replayed.
  twoFactorLastCounter Int?       @map("two_factor_last_counter")
  passwordHash         String     @map("password_hash") @db.VarChar(255)
  role                 UserRole   @default(administrator)
  status               UserStatus @default(active)
  createdAt            DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions               Session[]
  auditEventsAsActor     AuditEvent[]            @relation("AuditActor")
  auditEventsAsTarget    AuditEvent[]            @relation("AuditTarget")
  posts                  Post[]
  postRevisions          PostRevision[]
  mediaItems             MediaItem[]
  comments               Comment[]
  dataRequests           DataRequest[]
  applicationPasswords   ApplicationPassword[]
  postNotes              PostNote[]              @relation("PostNoteAuthor")
  resolvedPostNotes      PostNote[]              @relation("PostNoteResolver")
  trashedPostNotes       PostNote[]              @relation("PostNoteTrasher")
  passwordResets         PasswordReset[]
  twoFactorRecoveryCodes TwoFactorRecoveryCode[]
  twoFactorChallenges    TwoFactorChallenge[]

  @@map("users")
}

/// WordPress "Application Passwords": revocable per-device credentials for the API.
model ApplicationPassword {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  name         String    @db.VarChar(200)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  lastUsedAt   DateTime? @map("last_used_at") @db.Timestamptz(6)
  lastUsedIp   String?   @map("last_used_ip") @db.VarChar(64)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("application_passwords")
}

/// Delivery log for transactional mail. Recipient/subject/status only —
/// message bodies are never stored (they may contain passwords or tokens).
model MailLogEntry {
  id        String   @id @default(uuid(7)) @db.Uuid
  recipient String   @default("") @db.VarChar(320)
  subject   String   @default("") @db.VarChar(500)
  status    String   @db.VarChar(20)
  reason    String?  @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt])
  @@map("mail_log_entries")
}

/// Admin-managed path redirects (Tools → Redirects).
model Redirect {
  id         String   @id @default(uuid(7)) @db.Uuid
  fromPath   String   @unique @map("from_path") @db.VarChar(2048)
  toPath     String   @map("to_path") @db.VarChar(2048)
  statusCode Int      @default(301) @map("status_code")
  hits       Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("redirects")
}

/// Aggregated 404s for the Redirects screen. Only the path is stored (no PII).
model NotFoundEntry {
  id          String   @id @default(uuid(7)) @db.Uuid
  path        String   @unique @db.VarChar(2048)
  hits        Int      @default(1)
  firstSeenAt DateTime @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt  DateTime @updatedAt @map("last_seen_at") @db.Timestamptz(6)

  @@map("not_found_entries")
}

/// Hashed one-time recovery codes for two-factor authentication.
model TwoFactorRecoveryCode {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @unique @map("code_hash") @db.Char(64)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("two_factor_recovery_codes")
}

/// Short-lived login challenge issued after a correct password when 2FA is on.
model TwoFactorChallenge {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  remember  Boolean   @default(false)
  attempts  Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("two_factor_challenges")
}

/// Single-use password reset tokens (lost-password flow). Only the SHA-256 hash
/// of the token is stored; the plaintext exists only in the e-mail link.
model PasswordReset {
  id          String    @id @default(uuid(7)) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash") @db.Char(64)
  requestedIp String?   @map("requested_ip") @db.Char(64)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt      DateTime? @map("used_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_resets")
}

model Session {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  csrfHash   String    @map("csrf_hash") @db.Char(64)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt DateTime  @map("last_used_at") @db.Timestamptz(6)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model AuditEvent {
  id           String   @id @default(uuid(7)) @db.Uuid
  eventType    String   @map("event_type") @db.VarChar(64)
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  targetUserId String?  @map("target_user_id") @db.Uuid
  ipHash       String?  @map("ip_hash") @db.Char(64)
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor  User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  target User? @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([eventType, createdAt])
  @@map("audit_events")
}

model LoginAttempt {
  id          BigInt   @id @default(autoincrement())
  keyHash     String   @map("key_hash") @db.Char(64)
  attemptedAt DateTime @default(now()) @map("attempted_at") @db.Timestamptz(6)

  @@index([keyHash, attemptedAt])
  @@index([attemptedAt])
  @@map("login_attempts")
}

// ---- Phase 3: content + taxonomy (ADR 0003) ----
// Scoped per ADR 0003: no media/hierarchy/render-cache/scheduled/revision columns.

enum PostStatus {
  DRAFT
  PUBLISHED
  TRASHED
}

model Post {
  id              String      @id @default(uuid(7)) @db.Uuid
  type            String      @db.VarChar(32)
  status          PostStatus  @default(DRAFT)
  title           String      @db.VarChar(300)
  slug            String      @db.VarChar(200)
  excerpt         String?
  content         String      @default("")
  contentFormat   String      @default("wp_block_html") @map("content_format") @db.VarChar(32)
  contentVersion  Int         @default(1) @map("content_version")
  authorId        String?     @map("author_id") @db.Uuid
  seoTitle        String?     @map("seo_title") @db.VarChar(300)
  seoDescription  String?     @map("seo_description") @db.VarChar(500)
  canonicalUrl    String?     @map("canonical_url") @db.VarChar(2048)
  robots          String?     @db.VarChar(100)
  ogTitle         String?     @map("og_title") @db.VarChar(300)
  ogDescription   String?     @map("og_description") @db.VarChar(500)
  publishedAt     DateTime?   @map("published_at") @db.Timestamptz(6)
  trashedAt       DateTime?   @map("trashed_at") @db.Timestamptz(6)
  previousStatus  PostStatus? @map("previous_status")
  version         Int         @default(1)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// 64-hex revocable preview token (P8-03). Null = preview disabled.
  previewToken    String?     @unique @map("preview_token") @db.VarChar(64)
  /// First-publish scheduling (P8-04): a DRAFT with a past scheduledAt is
  /// promoted to PUBLISHED by the sweeper. Null = not scheduled.
  scheduledAt     DateTime?   @map("scheduled_at") @db.Timestamptz(6)
  /// Cumulative revision count (P8-01); pruning keeps the newest 50 rows.
  revisionCount   Int         @default(0) @map("revision_count")
  /// Featured image (Phase 6 follow-up); SetNull when the media item is deleted.
  featuredMediaId String?     @map("featured_media_id") @db.Uuid
  /// Per-post comment status (WordPress Discussion): open or closed.
  commentStatus   String      @default("open") @map("comment_status") @db.VarChar(20)
  /// Argon2id hash of the post password; null means the post is public.
  passwordHash    String?     @map("password_hash") @db.VarChar(255)
  /// WordPress "Private": excluded from every public surface.
  isPrivate       Boolean     @default(false) @map("is_private")
  /// WordPress post format (standard, aside, gallery, link, image, quote,
  /// status, video, audio, chat). Themes may style it; content is unchanged.
  format          String      @default("standard") @db.VarChar(20)
  /// WordPress "Make this post sticky": pinned above normal posts on the blog.
  sticky          Boolean     @default(false)
  /// Per-post editor-note mail override; null inherits the Discussion setting.
  notesNotify     Boolean?    @map("notes_notify")
  /// Safe client editing: structural block edits are rejected while locked.
  structureLocked Boolean     @default(false) @map("structure_locked")

  author        User?             @relation(fields: [authorId], references: [id], onDelete: SetNull)
  terms         PostTerm[]
  slugHistory   PostSlugHistory[]
  revisions     PostRevision[]
  comments      Comment[]
  notes         PostNote[]
  featuredMedia MediaItem?        @relation(fields: [featuredMediaId], references: [id], onDelete: SetNull)

  @@unique([type, slug])
  @@index([type, status, publishedAt])
  @@index([status, updatedAt])
  @@index([authorId])
  @@index([scheduledAt])
  @@index([featuredMediaId])
  @@map("posts")
}

/// Immutable pre-update content snapshots (P8-01). One row per save; the
/// newest 50 per post are kept. Restores go through the normal update path,
/// which itself writes a snapshot.
model PostRevision {
  id             String   @id @default(uuid(7)) @db.Uuid
  postId         String   @map("post_id") @db.Uuid
  /// 'revision' (immutable snapshot, retention 50) or 'autosave' (one per post, P8-02).
  kind           String   @default("revision") @db.VarChar(16)
  title          String   @db.VarChar(300)
  excerpt        String?
  content        String
  seoTitle       String?  @map("seo_title") @db.VarChar(300)
  seoDescription String?  @map("seo_description") @db.VarChar(500)
  canonicalUrl   String?  @map("canonical_url") @db.VarChar(2048)
  robots         String?  @db.VarChar(100)
  ogTitle        String?  @map("og_title") @db.VarChar(300)
  ogDescription  String?  @map("og_description") @db.VarChar(500)
  authorId       String?  @map("author_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  post   Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([postId, createdAt])
  @@index([postId, kind])
  @@map("post_revisions")
}

/// Comments (ADR 0009). Content is plain text; the public renderer escapes it.
enum CommentStatus {
  PENDING
  APPROVED
  SPAM
  TRASHED
}

model Comment {
  id          String        @id @default(uuid(7)) @db.Uuid
  postId      String        @map("post_id") @db.Uuid
  userId      String?       @map("user_id") @db.Uuid
  parentId    String?       @map("parent_id") @db.Uuid
  authorName  String        @map("author_name") @db.VarChar(200)
  authorEmail String        @map("author_email") @db.VarChar(254)
  authorUrl   String?       @map("author_url") @db.VarChar(2048)
  content     String        @db.Text
  status      CommentStatus @default(APPROVED)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  post    Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  user    User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentReplies")

  @@index([status, createdAt])
  @@index([postId, status])
  @@index([parentId])
  @@index([authorEmail])
  @@map("comments")
}

/// GDPR-style personal data requests (Tools → Export/Erase Personal Data).
enum DataRequestType {
  EXPORT
  ERASE
}

enum DataRequestStatus {
  PENDING
  COMPLETED
}

model DataRequest {
  id          String            @id @default(uuid(7)) @db.Uuid
  type        DataRequestType
  email       String            @db.VarChar(254)
  userId      String?           @map("user_id") @db.Uuid
  status      DataRequestStatus @default(PENDING)
  requestedBy String            @map("requested_by") @db.Uuid
  note        String?           @db.Text
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt DateTime?         @map("completed_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([type, status])
  @@index([email])
  @@map("data_requests")
}

/// Media library items (Phase 6). Files live under MEDIA_STORAGE_DIR with
/// random names; derivatives (WebP thumbnails) are tracked in `derivatives`.
/// Raster images only — no SVG (T-12), no video/documents in this slice.
model MediaItem {
  id           String    @id @default(uuid(7)) @db.Uuid
  /// Random stored base name without directories, e.g. "ab12cd34.webp".
  fileName     String    @map("file_name") @db.VarChar(120)
  originalName String    @map("original_name") @db.VarChar(255)
  mimeType     String    @map("mime_type") @db.VarChar(100)
  sizeBytes    Int       @map("size_bytes")
  width        Int?
  height       Int?
  altText      String    @default("") @map("alt_text") @db.VarChar(500)
  caption      String    @default("") @db.VarChar(2000)
  description  String    @default("") @db.Text
  /// Path relative to the storage root, e.g. "2026/10/ab12cd34.webp".
  storagePath  String    @map("storage_path") @db.VarChar(300)
  /// {"300": "2026/10/ab12cd34-300.webp", "600": ..., "1200": ...}
  derivatives  Json?
  uploadedById String?   @map("uploaded_by_id") @db.Uuid
  /// Set when the image was edited in the media editor (null = pristine).
  editedAt     DateTime? @map("edited_at") @db.Timestamptz(6)
  /// Relative path of the pre-edit backup used by "Restore original image".
  originalPath String?   @map("original_path") @db.VarChar(400)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  uploadedBy User?  @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  featuredOn Post[]

  @@index([createdAt])
  @@index([mimeType])
  @@map("media_items")
}

model PostSlugHistory {
  id        String   @id @default(uuid(7)) @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  oldSlug   String   @map("old_slug") @db.VarChar(200)
  changedAt DateTime @default(now()) @map("changed_at") @db.Timestamptz(6)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, changedAt])
  @@map("post_slug_history")
}

model Term {
  id          String   @id @default(uuid(7)) @db.Uuid
  taxonomy    String   @db.VarChar(32)
  name        String   @db.VarChar(200)
  slug        String   @db.VarChar(200)
  description String?
  parentId    String?  @map("parent_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  parent   Term?      @relation("TermParent", fields: [parentId], references: [id], onDelete: SetNull)
  children Term[]     @relation("TermParent")
  posts    PostTerm[]

  @@index([taxonomy, parentId])
  @@index([taxonomy, name])
  @@map("terms")
}

model PostTerm {
  postId   String @map("post_id") @db.Uuid
  termId   String @map("term_id") @db.Uuid
  position Int    @default(0)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  term Term @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@id([postId, termId])
  @@index([termId, postId])
  @@map("post_terms")
}

model Option {
  key       String   @id @db.VarChar(191)
  value     String   @db.Text
  group     String   @default("general") @db.VarChar(50)
  autoload  Boolean  @default(true) @map("autoload")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([group])
  @@map("options")
}

/// Editor notes: per-post discussion threads with replies and a resolved flag.
/// Notes are internal (never public) and require permission to edit the post.
model PostNote {
  id            String    @id @default(uuid(7)) @db.Uuid
  postId        String    @map("post_id") @db.Uuid
  authorId      String?   @map("author_id") @db.Uuid
  parentId      String?   @map("parent_id") @db.Uuid
  content       String    @db.Text
  /// Optional block anchor (root notes only): block name, path and content hash.
  blockName     String?   @map("block_name") @db.VarChar(100)
  blockPath     String?   @map("block_path") @db.VarChar(100)
  blockHash     String?   @map("block_hash") @db.VarChar(32)
  /// Short plain-text fingerprint used to distinguish "changed" from "removed".
  blockText     String?   @map("block_text") @db.VarChar(200)
  /// Stable id stored in the block's metadata.anchorId attribute (root notes).
  blockAnchorId String?   @map("block_anchor_id") @db.VarChar(32)
  /// Soft delete: set when the note is moved to Trash; cleared on restore.
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedById   String?   @map("deleted_by_id") @db.Uuid
  resolvedAt    DateTime? @map("resolved_at") @db.Timestamptz(6)
  resolvedById  String?   @map("resolved_by_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  post       Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  author     User?      @relation("PostNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  resolvedBy User?      @relation("PostNoteResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  deletedBy  User?      @relation("PostNoteTrasher", fields: [deletedById], references: [id], onDelete: SetNull)
  parent     PostNote?  @relation("PostNoteThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies    PostNote[] @relation("PostNoteThread")

  @@index([postId, createdAt])
  @@index([postId, deletedAt])
  @@map("post_notes")
}
