{
  "name": "@mernpress/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "prisma",
    "prisma7.config.ts"
  ],
  "scripts": {
    "generate": "prisma generate",
    "migrate": "prisma migrate deploy && tsx src/check-database.ts",
    "migrate:test": "tsx src/migrate-test.ts",
    "reset:test": "tsx src/reset-test.ts",
    "seed": "tsx src/seed.ts",
    "verify": "tsx src/check-database.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "prisma generate && tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "18.0.9",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "prisma": "7.10.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
