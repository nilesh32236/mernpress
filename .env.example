# Copy this file to .env and replace the placeholder values.
# Never commit .env or real credentials.

NODE_ENV=development
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info

# PostgreSQL connection string. Create the role/database first; see README.
# Example: postgresql://mernpress:change-me@127.0.0.1:5432/mernpress_dev
DATABASE_URL=postgresql://mernpress:change-me@127.0.0.1:5432/mernpress_dev

# Comma-separated browser origins allowed to call the API with credentials.
# The MVP serves the admin and /api on one origin (Vite proxy or a reverse
# proxy). Keep this set to the browser origin; never use a wildcard here.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Dedicated database for tests; never point this at development data.
TEST_DATABASE_URL=postgresql://mernpress:change-me@127.0.0.1:5432/mernpress_test

# Server-side pepper for audit/rate-limit IP and username hashes.
AUTH_HASH_PEPPER=replace-with-a-long-random-auth-hash-pepper
