{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalEnv": [
    "DATABASE_URL",
    "TEST_DATABASE_URL",
    "CORS_ORIGINS",
    "NODE_ENV",
    "HOST",
    "PORT",
    "LOG_LEVEL",
    "TRUST_PROXY",
    "SESSION_TTL_MINUTES",
    "SESSION_IDLE_MINUTES",
    "LOGIN_RATE_LIMIT_MAX",
    "LOGIN_RATE_LIMIT_WINDOW_MINUTES",
    "AUTH_HASH_PEPPER"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
