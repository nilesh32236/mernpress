{
  "id": "mernpress",
  "name": "MERNPress",
  "version": "0.2.0",
  "author": { "name": "MERNPress", "url": null },
  "description": "The default MERNPress theme. A block theme for the public site: blog index, single posts and pages, category, tag and author archives, search, comments and a site editor-ready header and footer. It is built on the same block contracts as the admin editor, so published block markup renders server-side.",
  "tags": [
    "Blog",
    "One Column",
    "Block Editor Styles",
    "Custom Colors",
    "Editor Style",
    "Featured Images",
    "Full Site Editing",
    "News",
    "Accessibility Ready"
  ],
  "screenshot": "/theme-screenshot.png",
  "layout": "classic",
  "features": [
    "Block editor styles",
    "Featured images",
    "Full site editing",
    "Threaded comments",
    "Wide blocks"
  ],
  "fonts": [
    { "family": "Manrope", "weights": [300, 400, 600, 700], "source": "theme" },
    { "family": "System UI", "weights": [400, 600], "source": "system" }
  ],
  "tokens": {
    "background": "#ffffff",
    "surface": "#ffffff",
    "text": "#111111",
    "muted": "#686868",
    "accent": "#111111",
    "headingFont": "var(--font-manrope), Manrope, sans-serif",
    "bodyFont": "var(--font-manrope), Manrope, sans-serif",
    "contentWidth": "645px",
    "radius": "0px",
    "headerAlign": "left"
  }
}
