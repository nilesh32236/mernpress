{
  "name": "mernpress",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.22.1 <25",
    "pnpm": ">=12.15.0 <13"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "pnpm db:generate && turbo run build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm db:generate && turbo run typecheck",
    "test": "pnpm db:generate && pnpm db:migrate:test && turbo run test",
    "test:e2e": "pnpm db:generate && pnpm db:migrate:test && pnpm db:reset:test && playwright test",
    "db:generate": "pnpm --filter @mernpress/database generate",
    "db:migrate": "pnpm --filter @mernpress/database migrate",
    "db:migrate:test": "pnpm --filter @mernpress/database migrate:test",
    "db:reset:test": "pnpm --filter @mernpress/database reset:test",
    "db:seed": "pnpm --filter @mernpress/database seed",
    "db:verify": "pnpm --filter @mernpress/database verify",
    "auth:bootstrap": "pnpm --filter @mernpress/api auth:bootstrap",
    "dev:create-test-account": "pnpm --filter @mernpress/api dev:create-test-account",
    "db:local:init": "node scripts/local-db.mjs init",
    "db:local:start": "node scripts/local-db.mjs start",
    "db:local:stop": "node scripts/local-db.mjs stop",
    "db:local:status": "node scripts/local-db.mjs status",
    "setup": "node scripts/setup.mjs",
    "check:bundle": "node scripts/check-admin-bundle.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "dotenv": "18.0.9"
  }
}
