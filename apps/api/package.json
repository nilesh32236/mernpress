{
  "name": "@mernpress/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "NODE_OPTIONS=--conditions=development tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "auth:bootstrap": "NODE_OPTIONS=--conditions=development tsx src/cli/bootstrap-admin.ts",
    "dev:create-test-account": "NODE_OPTIONS=--conditions=development tsx src/cli/create-test-account.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "notes:purge-trash": "NODE_OPTIONS=--conditions=development tsx src/cli/purge-notes-trash.ts",
    "analytics:prune": "NODE_OPTIONS=--conditions=development tsx src/cli/prune-analytics.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/cors": "11.3.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/multipart": "10.1.6",
    "@mernpress/block-system": "workspace:*",
    "@mernpress/cms-core": "workspace:*",
    "@mernpress/contracts": "workspace:*",
    "@mernpress/database": "workspace:*",
    "@wordpress/block-serialization-default-parser": "6.0.0",
    "dotenv": "18.0.9",
    "fastify": "5.12.7",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
