{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "types": ["vite/client"],
    "paths": {
      "@wordpress/block-editor": ["./node_modules/@wordpress/block-editor/build-types/index.d.ts"],
      "@wordpress/block-library": ["./node_modules/@wordpress/block-library/build-types/index.d.ts"]
    }
  },
  "include": ["src", "vite.config.ts", "vitest.config.ts"],
  "exclude": ["dist", "node_modules"]
}
